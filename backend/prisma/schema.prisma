generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id           String         @id @default(uuid())
  name         String
  phone        String         @unique
  email        String?        @unique
  source       String
  status       String         @default("NEW")
  owner_id     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deleted_at   DateTime?
  branchId     String?        @db.Uuid
  tenantId     String?        @db.Uuid
  applications Application[]
  activities   LeadActivity[]
}

model LeadActivity {
  id        String   @id @default(uuid())
  lead_id   String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id])
}

model User {

  id            String         @id @default(uuid()) @db.VarChar(250)
  name          String         @db.VarChar(250)
  email         String         @unique @db.VarChar(250)
  role          String?        @db.VarChar(250)
  passwordHash  String?        @db.VarChar(250)
  phone         String?        @db.VarChar(250)
  createdAt     DateTime       @default(now())

  refreshTokens RefreshToken[]
  roles         UserRole[]
  createdAt     DateTime       @default(now())

  passwordHash  String         @db.VarChar(250)
  phone         String         @unique @db.VarChar(250)
  refreshTokens RefreshToken[]
  roles         UserRole[]
  createdAt     DateTime       @default(now())
  tenantId      String?        @map("tenant_id") @db.Uuid
  status        Boolean        @default(true)
  updatedAt     DateTime?      @map("updated_at")
  branchId      String?        @db.Uuid

  id                         String              @id @default(uuid()) @db.VarChar(250)
  name                       String              @db.VarChar(250)
  email                      String              @unique @db.VarChar(250)
  createdAt                  DateTime            @default(now())
  passwordHash               String              @db.VarChar(250)
  phone                      String              @unique @db.VarChar(250)
  status                     Boolean             @default(true)
  tenantId                   String?             @map("tenant_id") @db.Uuid
  updatedAt                  DateTime?           @map("updated_at")
  branchId                   String?             @db.Uuid
  role                       String?             @db.VarChar(250)
  refreshTokens              RefreshToken[]
  roles                      UserRole[]
  verifiedAdmissionDocuments AdmissionDocument[] @relation("AdmissionDocumentVerifiedBy")

  @@map("User")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  jti       String   @unique

 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([userId])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?  @map("tenant_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("RefreshToken")

}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  createdAt   DateTime         @default(now())

  permissions RolePermission[]
  users       UserRole[]
}

model UserRole {
  id     Int    @id @default(autoincrement())
  userId String
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Permission {
  id        Int      @id @default(autoincrement())
  module    String
  action    String
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Application {
  id                 String              @id @default(uuid())
  leadId             String
  programId          String
  formData           Json
  status             ApplicationStatus   @default(DRAFT)
  submittedAt        DateTime?
  reviewedBy         String?
  notes              String?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenantId           String?             @db.Uuid
  branchId           String?             @db.Uuid
  applicationRef     String?             @unique @db.VarChar(30)
  lead               Lead                @relation(fields: [leadId], references: [id])
  admissionDocuments AdmissionDocument[]

  @@index([tenantId, leadId])
  @@index([tenantId, branchId, status])
  @@index([createdAt])
}

model AdmissionDocument {
  id            String         @id @default(uuid())
  applicationId String
  documentType  DocumentType
  fileKey       String
  fileName      String?
  fileSize      BigInt
  fileType      String
  status        DocumentStatus @default(UPLOADED)
  verifiedBy    String?        @db.VarChar(250)
  verifiedAt    DateTime?
  createdAt     DateTime       @default(now())
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verifiedUser  User?          @relation("AdmissionDocumentVerifiedBy", fields: [verifiedBy], references: [id])

  @@index([applicationId])
  @@index([status])
  @@map("admission_documents")
}

model Student {
  tenant_id      String?  @db.Uuid
  application_id String   @unique @db.Uuid
  user_id        String   @db.Uuid
  profile_data   Json
  status         String   @default("ENROLLED") @db.VarChar(20)
  created_at     DateTime @default(now())
  id             String   @id @default(uuid()) @db.Uuid

  @@index([application_id], map: "idx_students_application_unique")
  @@index([user_id], map: "idx_students_user_id")
}

model OfferLetter {
  application_id String   @db.Uuid
  file_key       String
  generated_by   String   @db.Uuid
  generated_at   DateTime @default(now())
  id             String   @id @default(uuid()) @db.Uuid

  @@index([application_id], map: "idx_offer_application_id")
}

model ActivityTimeline {
  id          String             @id @default(uuid())
  entityType  TimelineEntityType
  entityId    String             @db.Uuid
  eventType   TimelineEventType
  title       String?
  description String?
  actorId     String?            @db.Uuid
  createdAt   DateTime           @default(now())

  @@index([createdAt], map: "idx_timeline_created_at")
  @@index([entityType, entityId], map: "idx_timeline_entity")
}

model Audit_Logs {
  id         String   @id @default(uuid())
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String   @db.Uuid
  actorId    String?  @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt], map: "idx_audit_created_at")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@map("audit_logs")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  tableName String
  action    String
  oldValue  Json?
  newValue  Json?
  userId    String?
  createdAt DateTime @default(now())
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  UNDER_REVIEW
  DOCUMENT_VERIFIED
  APPROVED
  REJECTED
  ENROLLED
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum TimelineEntityType {
  APPLICATION
  STUDENT
}

enum TimelineEventType {
  STATUS_CHANGED
  CREATED
}

enum DocumentOwnerType {
  APPLICATION
  STUDENT
  STAFF
  OTHER
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  ACADEMIC_RECORD
  PHOTO
  OTHER
}
