generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id           String         @id @default(uuid())
  name         String
  phone        String         @unique
  email        String?        @unique
  source       String
  status       String         @default("NEW")
  owner_id     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  activities   LeadActivity[]
  deleted_at   DateTime?
  tenantId     String?        @db.Uuid
  branchId     String?        @db.Uuid
  applications Application[] //✅ new added field
}

model LeadActivity {
  id        String   @id @default(uuid())
  lead_id   String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id])
}

model User {
  id            String         @id @default(uuid()) @db.VarChar(250)
  name          String         @db.VarChar(250)
  email         String         @unique @db.VarChar(250)
  role          String?        @db.VarChar(250)

  passwordHash  String         @db.VarChar(250)
  phone         String         @unique @db.VarChar(250)

  refreshTokens RefreshToken[]
  roles         UserRole[]
  createdAt     DateTime       @default(now())
  tenantId      String?        @map("tenant_id") @db.Uuid
  status        Boolean        @default(true)
  updatedAt     DateTime?      @map("updated_at")
  branchId      String?        @db.Uuid

  @@map("User")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  jti       String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?  @map("tenant_id") @db.Uuid

  @@index([userId])
  @@index([tenantId])
  @@map("RefreshToken")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  tableName String
  action    String
  oldValue  Json?
  newValue  Json?
  userId    String?
  createdAt DateTime @default(now())
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]
}

model UserRole {
  id     Int    @id @default(autoincrement())
  userId String
  roleId Int
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Permission {
  id              Int              @id @default(autoincrement())
  module          String
  action          String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  
}

//// Application Model
/// Stores admission application data linked to a Lead.
/// Acts as the core entity for the admissions workflow.

model Application {
  /// Primary identifier for the application
  /// Generated as UUID to ensure global uniqueness

  id String @id @default(uuid())

  /// Reference to the lead who initiated this application
  /// Ensures traceability from enquiry → application

  leadId String

  /// Relation to Lead entity
  /// onDelete: Restrict prevents accidental deletion of applications

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  /// Selected academic program for which the student is applying
  /// Stored as String in Sprint-2; converted to FK in Sprint-3

  programId String

  /// Dynamic form response data submitted by the applicant
  /// Stored as JSON to support flexible, institution-specific fields

  formData Json

  /// Tracks the current stage of the application lifecycle
  /// Default is DRAFT to support partial form completion

  status ApplicationStatus @default(DRAFT)

  /// Tenant identifier for multi-tenant isolation
  /// Ensures data separation between institutions

  tenantId String? @db.Uuid

  /// Branch identifier for operational and reporting isolation
  /// Allows filtering applications by physical branch/location

  branchId String? @db.Uuid

  /// Timestamp when the application is formally submitted
  /// Used to differentiate drafts from submitted applications

  submittedAt DateTime?

  /// User ID of the admin/counsellor who reviewed the application
  /// Helps in accountability and audit tracking

  reviewedBy String?

  /// Internal notes added during review or processing
  /// Not visible to the applicant

  notes String?

  /// Soft delete timestamp
  /// Allows logical deletion without losing historical data

  deletedAt DateTime?

  /// Timestamp when the application record was created
  /// Used for auditing and chronological reporting

  createdAt DateTime @default(now())

  /// Timestamp automatically updated on every modification
  /// Helps track updates and detect stale data

  updatedAt DateTime @updatedAt

  /// Optimizes lookup of applications by tenant and lead

  /// Supports filtering applications by branch and status
  /// Commonly used in admission dashboards

  /// Enables efficient sorting and pagination by creation date

  @@index([tenantId, leadId])
  @@index([tenantId, branchId, status])
  @@index([createdAt])
}


enum DocumentOwnerType {
  APPLICATION
  STUDENT
  STAFF
  OTHER
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  ACADEMIC_RECORD
  PHOTO
  OTHER
}

// ADMISSION DOCUMENTS (PRD 3)
// admission_documents

// Column Type Constraints

// id UUID

// PK application_id UUID

// FK → applications(id)

// document_type VARCHAR(50) AADHAR / MARKSHEET / PHOTO

// file_key TEXT NOT NULL

// file_name TEXT

// file_size BIGINT

// status VARCHAR(20)
// UPLOADED / VERIFIED / REJECTED

// verified_by UUID

// FK → users(id)

// verified_at TIMESTAMP

// created_at TIMESTAMP DEFAULT now()

// Indexes
// idx_docs_application_id
// idx_docs_status

model Document {
  id             String   @id @default(uuid())

  application_id  String  @default(uuid())

  // Polymorphic ownership
  ownerType      DocumentOwnerType
  ownerId        String    @db.Uuid

  // File metadata
  fileKey        String
  fileName       String
  fileSize       Int
  fileType       String   // MIME type

  // Document classification
  documentType   DocumentType

  // Verification
  verified       Boolean   @default(false)
  verifiedBy     String?
  verifiedAt     DateTime?

  // Multi-tenancy
  tenantId       String
  branchId       String

  // Audit & retention
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@index([ownerType, ownerId])
  @@index([tenantId, verified])
  @@index([documentType])
}


