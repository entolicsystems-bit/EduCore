generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  phone        String         @unique
  email        String         @unique
  source       String
  status       String         @default("NEW")
  owner_id     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deleted_at   DateTime?
  branchId     String?        @db.Uuid
  tenantId     String?        @db.Uuid
  emailHash    String         @unique
  phoneHash    String         @unique
  applications Application[]
  activities   LeadActivity[]
}

model LeadActivity {
  id        String   @id @default(uuid()) @db.Uuid
  lead_id   String   @db.Uuid
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id])
}

model User {
  //id                       String              @id @default(uuid()) @db.VarChar(250)
  id                         String              @id @default(uuid()) @db.Uuid
  name                       String              @db.VarChar(250)
  email                      String              @unique @db.VarChar(250)
  createdAt                  DateTime            @default(now())
  passwordHash               String              @db.VarChar(250)
  phone                      String              @unique @db.VarChar(250)
  status                     Boolean             @default(true)
  tenantId                   String?             @map("tenant_id") @db.Uuid
  updatedAt                  DateTime?           @map("updated_at")
  branchId                   String?             @db.Uuid
  role                       String?             @db.VarChar(250)
  refreshTokens              RefreshToken[]
  roles                      UserRole[]
  students_updated           Student[]
  verifiedAdmissionDocuments AdmissionDocument[] @relation("AdmissionDocumentVerifiedBy")
  teacherAssignments         TeacherAssignment[]
  staffs                     Staff[]
  parents                    Parent[]

  @@map("User")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  jti       String   @unique
  tenantId  String?  @map("tenant_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("RefreshToken")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]
}

model UserRole {
  userId String  @db.Uuid
  roleId Int
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffs Staff[]

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Permission {
  id              Int              @id @default(autoincrement())
  module          String
  action          String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Application {
  id         String  @id @default(uuid()) @db.Uuid
  leadId     String  @db.Uuid
  programId  String  @db.Uuid
  reviewedBy String? @db.Uuid

  formData           Json
  status             ApplicationStatus   @default(DRAFT)
  submittedAt        DateTime?
  notes              String?
  leadImageUrl       String?             @db.VarChar(500)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenantId           String?             @db.Uuid
  branchId           String?             @db.Uuid
  applicationRef     String?             @unique @db.VarChar(30)
  lead               Lead                @relation(fields: [leadId], references: [id])
  student            Student?
  admissionDocuments AdmissionDocument[]

  @@index([tenantId, leadId])
  @@index([tenantId, branchId, status])
  @@index([createdAt])
}

model AdmissionDocument {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @db.Uuid
  documentType  DocumentType
  fileKey       String
  fileName      String?
  fileSize      BigInt
  fileType      String
  status        DocumentStatus @default(UPLOADED)
 verifiedBy String? @db.Uuid
  verifiedAt    DateTime?
  createdAt     DateTime       @default(now())
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verifiedUser  User?          @relation("AdmissionDocumentVerifiedBy", fields: [verifiedBy], references: [id])

  @@index([applicationId])
  @@index([status])
  @@map("admission_documents")
}

model Student {
  tenant_id      String?           @db.Uuid
  application_id String            @unique @db.Uuid
  application    Application       @relation(fields: [application_id], references: [id])
  created_by     String            @db.Uuid
  profile_data   Json
  created_at     DateTime          @default(now())
  id             String            @id @default(uuid()) @db.Uuid
  updated_at     DateTime          @updatedAt
  status         ApplicationStatus @default(ENROLLED)
  student_status StudentStatus     @default(ACTIVE)
  updated_by_id  String? @db.Uuid
  updated_by     User?             @relation(fields: [updated_by_id], references: [id])
  branch_id      String            @db.Uuid
  is_deleted           Boolean                   @default(false) 
  deleted_at          DateTime?     

  timetable         Timetable[]
  parentStudentMaps PARENT_STUDENT_MAP[]
  enrollments       Enrollment[]

  @@index([application_id], map: "idx_students_application_unique")
  @@index([created_by], map: "idx_students_user_id")
}

model OfferLetter {
  application_id String   @db.Uuid
  file_key       String
  generated_by   String   @db.Uuid
  generated_at   DateTime @default(now())
  id             String   @id @default(uuid()) @db.Uuid

  @@index([application_id], map: "idx_offer_application_id")
}

model ActivityTimeline {
  id          String             @id @default(uuid()) @db.Uuid
  entityType  TimelineEntityType
  entityId    String             @db.Uuid
  eventType   TimelineEventType
  title       String?
  description String?
  actorId     String?            @db.Uuid
  createdAt   DateTime           @default(now())

  @@index([createdAt], map: "idx_timeline_created_at")
  @@index([entityType, entityId], map: "idx_timeline_entity")
}

model Audit_Logs {
  id         String   @id @default(uuid()) @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String   @db.Uuid
  actorId    String?  @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt], map: "idx_audit_created_at")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@map("audit_logs")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  tableName String
  action    String
  oldValue  Json?
  newValue  Json?
  userId    String?
  createdAt DateTime @default(now())
}

//sprint 3 

model Staff {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  branchId   String      @db.Uuid
  userId     String      @db.Uuid
  name       String      @db.VarChar(150)
  role       String      @db.VarChar(50)
  department String?     @db.VarChar(100)
  status     StaffStatus @default(ACTIVE)
  createdAt  DateTime    @default(now())

  user           User                @relation(fields: [userId], references: [id])
  assignments    TeacherAssignment[]
  userRoleId     Int
  userRole       UserRole?           @relation(fields: [userRoleUserId, userRoleRoleId], references: [userId, roleId])
  userRoleUserId String?             @db.Uuid
  userRoleRoleId Int?

  @@map("staff")
}

model Parent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  branchId     String   @db.Uuid
  userId       String?  @db.Uuid
  name         String   @db.VarChar(150)
  phone        String?  @unique @db.VarChar(20)
  email        String?  @unique @db.VarChar(150)
  relationship String   @db.VarChar(50) // FATHER / MOTHER / GUARDIAN
  status       String   @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime @default(now())

  user     User?                @relation(fields: [userId], references: [id])
  students PARENT_STUDENT_MAP[]

  @@map("parents")
}

model PARENT_STUDENT_MAP {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String   @db.Uuid
  studentId String   @db.Uuid
  createdAt DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@map("parent_students")
}

model Course {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  name         String        @db.VarChar(150)
  description  String?
  subjects     Json?
  status       CourseStatus  @default(ACTIVE)
  duration     Int?
  durationType DurationType?
  createdAt    DateTime      @default(now())

  batches Batch[]

  @@map("courses")
}

model Batch {
  id        String    @id @default(uuid()) @db.Uuid
  courseId  String    @db.Uuid
  tenantId  String    @db.Uuid
  branchId  String    @db.Uuid
  name      String    @db.VarChar(100)
  capacity  Int
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())

  course      Course              @relation(fields: [courseId], references: [id])
  enrollments Enrollment[]
  assignments TeacherAssignment[]
  timetable   Timetable?

  @@map("batches")
}

model TeacherAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @db.Uuid
  batchId   String   @db.Uuid
  role      String   @db.VarChar(20) // PRIMARY / ASSISTANT
  createdAt DateTime @default(now())

  teacher Staff   @relation(fields: [teacherId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
 userId String? @db.Uuid

  @@map("teacher_assignments")
}

model Timetable {
  id            String   @id @default(uuid()) @db.Uuid
  batchId       String   @unique @db.Uuid
  timetableJson Json
  updatedAt     DateTime @updatedAt

  batch     Batch    @relation(fields: [batchId], references: [id])
  student   Student? @relation(fields: [studentId], references: [id])
  studentId String?  @db.Uuid

  @@map("timetables")
}

model Enrollment {
  id         String           @id @default(uuid()) @db.Uuid
  studentId  String           @db.Uuid
  batchId    String           @db.Uuid
  status     EnrollmentStatus @default(ENROLLED)
  enrolledAt DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])

  @@unique([studentId, batchId])
  @@map("enrollments")
}

enum TeacherRole {
  PRIMARY
  ASSISTANT
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  DOCUMENT_VERIFIED
  APPROVED
  REJECTED
  ENROLLED
  DRAFT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum TimelineEntityType {
  APPLICATION
  STUDENT
}

enum TimelineEventType {
  STATUS_CHANGED
  CREATED
}

enum DocumentOwnerType {
  APPLICATION
  STUDENT
  STAFF
  OTHER
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  ACADEMIC_RECORD
  PHOTO
  OTHER
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum DurationType {
  MONTH
  YEAR
}